{
  "expo": {
    "name": "Sevikaa",
    "slug": "sevikaa",
    "scheme": "sevikaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.sevikaa.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sevikaa requires your location to calculate accurate distances to gated working societies."
      }
    },
    "android": {
      "package": "in.sevikaa.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/icon.png"
      },
      "navigationBar": {
        "visible": "always",
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sevikaa requires your location to calculate accurate distances to gated working societies."
        }
      ],
      "expo-video"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
